    "from io import BytesIO\n",
    "import requests\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def download(table, **selectors):\n",
    "    \"\"\"Download a StatBank table as a DataFrame. Each keyword is one variable code; '*' selects all values.\"\"\"\n",
    "    url = f'https://api.statbank.dk/v1/data/{table}/CSV'\n",
    "    params = dict(lang='en', valuePresentation='Code', **selectors)\n",
    "    response = requests.get(url, params=params, timeout=45)\n",
    "    response.raise_for_status()\n",
    "    frame = pd.read_csv(BytesIO(response.content), sep=';', dtype=str, encoding='utf-8-sig')\n",
    "    frame = frame.rename(columns={frame.columns[-1]: 'value'})\n",
    "    frame['value'] = pd.to_numeric(frame['value'].str.replace(',', '.', regex=False))\n",
    "    return frame\n",
    "\n",
    "settings = dict(PRISENHED='006', ALDER='*', Tid='2024')  # nominal DKK, all age groups, 2024\n",
    "percentiles = download('FORMUE16', PERCENTIL='*', **settings)\n",
    "percentiles.head()"
   ]
  },
