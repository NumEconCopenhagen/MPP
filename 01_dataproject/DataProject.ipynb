   "source": [
    "# a. older Denmark: move 5 percentage points from 18-29 to 70-79\n",
    "shares_old = shares.copy()\n",
    "shares_old['18-29'] -= 0.05\n",
    "shares_old['70-79'] += 0.05\n",
    "print(f'Sum of new shares: {shares_old.sum():.6f}')\n",
    "display(pd.DataFrame({'2024, %': 100*shares, 'older, %': 100*shares_old}).round(2))\n",
    "\n",
    "# b. run the second economy again with the same seed\n",
    "age_old, rank_old, wealth_old = wealthsim.simulate_wealth(shares_old.to_numpy(), values, within_variation=True)\n",
    "\n",
    "# c. compare with 2.2\n",
    "compare_old = pd.DataFrame([summary(wealth_var), summary(wealth_old)],\n",
    "                           index=['2024 age shares (2.2)', 'Older Denmark'])\n",
    "compare_old.loc['Change'] = compare_old.loc['Older Denmark'] - compare_old.loc['2024 age shares (2.2)']\n",
    "display(compare_old.style.format({'P10': '{:,.0f}', 'P50': '{:,.0f}', 'P90': '{:,.0f}',\n",
    "                                  'P90 - P10': '{:,.0f}', 'negative wealth, %': '{:.1f}'}))"
